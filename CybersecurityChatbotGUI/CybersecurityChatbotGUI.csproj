<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Chatbot.cs" />
	  <Compile Remove="MemoryStore.cs" />
	  <Compile Remove="QuizManager.cs" />
	  <Compile Remove="QuizQuestion.cs" />
	  <Compile Remove="SentimentDetector.cs" />
	  <Compile Remove="VoiceGreeting.cs" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="Chatbot.cs">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
	<ItemGroup>
	  <None Include="CybersecurityChatbotGUI\CybersecurityChatbotGUI.csproj" />
	  <None Include="CybersecurityChatbotGUI\CybersecurityChatbotGUI.csproj.user" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="MySql.Data" Version="26.10.0" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="CybersecurityChatbotGUI\ChatbotForm.cs">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Compile>
	</ItemGroup>
</Project>